geom_point(alpha = 0.6, size = 0.5) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50", alpha = 0.7) +
geom_text_repel(
aes(label = decoyID),
size = 2.5,
box.padding = unit(0.35, "lines"),
point.padding = unit(0.3, "lines"),
segment.color = 'grey50',
min.segment.length = 0,
max.overlaps = Inf
) +
scale_color_manual(values = rep(c("#1f77b4", "#ff7f0e"), length.out = length(chr_levels_delta))) +
scale_x_continuous(
breaks = chr_centers_delta,
labels = names(chr_centers_delta),
expand = expansion(mult = 0.01)
) +
labs(
title = "Manhattan Plot: MaxEntScan Delta Score (Decoy - Canonical) Across Genome (Top 100 phastCons Decoys)",
subtitle = paste("Total decoy sites plotted:", nrow(plot_data_delta)),
x = "Chromosome",
y = "MaxEntScan Delta Score (Decoy - Canonical)",
color = "Chromosome"
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 12),
axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
axis.text.y = element_text(size = 10),
legend.position = "none",
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
panel.grid.minor.y = element_blank()
)
print(p_manhattan_delta)
# Print summary statistics
cat("\n=== Manhattan Plot Summary (MaxEntScan Delta) ===\n")
cat("  Total points plotted:", nrow(plot_data_delta), "\n")
cat("  Chromosomes:", length(chr_levels_delta), "\n")
cat("  MaxEnt_delta range:", round(min(plot_data_delta$MaxEnt_delta, na.rm = TRUE), 4), "-",
round(max(plot_data_delta$MaxEnt_delta, na.rm = TRUE), 4), "\n")
cat("  MaxEnt_delta mean:", round(mean(plot_data_delta$MaxEnt_delta, na.rm = TRUE), 4), "\n")
cat("  Positive delta (decoy > canonical):", sum(plot_data_delta$MaxEnt_delta > 0, na.rm = TRUE), "\n")
cat("  Negative delta (decoy < canonical):", sum(plot_data_delta$MaxEnt_delta < 0, na.rm = TRUE), "\n")
# Get top 100 decoys from phastCons analysis (if available)
top100_decoys_spliceai <- NULL
if (exists("top100_both") && length(top100_both) > 0) {
top100_decoys_spliceai <- top100_both
} else {
# Fallback: use top 100 by phastCons if top100_both not available
data_with_phastcons_temp <- final_data[!is.na(final_data$phastCons) & !is.na(final_data$phastCons100way), ]
if (nrow(data_with_phastcons_temp) > 0) {
top100_phastcons_temp <- data_with_phastcons_temp %>%
arrange(desc(phastCons)) %>%
slice_head(n = 100) %>%
pull(decoyID)
top100_phastcons100way_temp <- data_with_phastcons_temp %>%
arrange(desc(phastCons100way)) %>%
slice_head(n = 100) %>%
pull(decoyID)
top100_decoys_spliceai <- intersect(top100_phastcons_temp, top100_phastcons100way_temp)
}
}
# Prepare data for Manhattan plot with SpliceAI score - filter to top 100 decoys only
plot_data_spliceai <- final_data %>%
filter(!is.na(SpliceAI_score) & SpliceAI_score != -1) %>%
{ if (!is.null(top100_decoys_spliceai) && length(top100_decoys_spliceai) > 0) filter(., decoyID %in% top100_decoys_spliceai) else . } %>%
select(chr, start, end, SpliceAI_score, decoyID)
# Order chromosomes (standard order + any non-standard)
chr_order <- c(paste0("chr", c(1:22, "X", "Y", "M")))
chr_levels_spliceai <- unique(plot_data_spliceai$chr)
chr_levels_spliceai <- c(intersect(chr_order, chr_levels_spliceai), setdiff(chr_levels_spliceai, chr_order))
plot_data_spliceai$chr <- factor(plot_data_spliceai$chr, levels = chr_levels_spliceai)
# Sort by chromosome and position
plot_data_spliceai <- plot_data_spliceai %>%
arrange(chr, start)
# Calculate cumulative positions for Manhattan plot
chr_lengths_spliceai <- plot_data_spliceai %>%
group_by(chr) %>%
summarise(max_pos = max(end, na.rm = TRUE), .groups = "drop") %>%
arrange(factor(chr, levels = chr_levels_spliceai))
# Calculate cumulative start positions for each chromosome
cumulative_pos_spliceai <- 0
chr_centers_spliceai <- numeric(length(chr_levels_spliceai))
names(chr_centers_spliceai) <- chr_levels_spliceai
plot_data_spliceai$cumulative_pos <- NA_real_
for (i in seq_along(chr_levels_spliceai)) {
chr_name <- chr_levels_spliceai[i]
chr_data <- plot_data_spliceai[plot_data_spliceai$chr == chr_name, ]
if (nrow(chr_data) > 0) {
chr_max_pos <- max(chr_data$end, na.rm = TRUE)
chr_centers_spliceai[chr_name] <- cumulative_pos_spliceai + chr_max_pos / 2
# Add positions for this chromosome
plot_data_spliceai$cumulative_pos[plot_data_spliceai$chr == chr_name] <-
cumulative_pos_spliceai + chr_data$start
cumulative_pos_spliceai <- cumulative_pos_spliceai + chr_max_pos + max(chr_lengths_spliceai$max_pos, na.rm = TRUE) * 0.02
}
}
# Create Manhattan plot with labels for top 100 decoys
p_manhattan_spliceai <- ggplot(plot_data_spliceai, aes(x = cumulative_pos, y = SpliceAI_score, color = chr)) +
geom_point(alpha = 0.6, size = 0.5) +
geom_text_repel(
aes(label = decoyID),
size = 2.5,
box.padding = unit(0.35, "lines"),
point.padding = unit(0.3, "lines"),
segment.color = 'grey50',
min.segment.length = 0,
max.overlaps = Inf
) +
scale_color_manual(values = rep(c("#1f77b4", "#ff7f0e"), length.out = length(chr_levels_spliceai))) +
scale_x_continuous(
breaks = chr_centers_spliceai,
labels = names(chr_centers_spliceai),
expand = expansion(mult = 0.01)
) +
labs(
title = "Manhattan Plot: SpliceAI Scores Across Genome (Top 100 phastCons Decoys)",
subtitle = paste("Total decoy sites plotted:", nrow(plot_data_spliceai)),
x = "Chromosome",
y = "SpliceAI Score",
color = "Chromosome"
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 12),
axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
axis.text.y = element_text(size = 10),
legend.position = "none",
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
panel.grid.minor.y = element_blank()
)
print(p_manhattan_spliceai)
# Print summary statistics
cat("\n=== Manhattan Plot Summary (SpliceAI) ===\n")
cat("  Total points plotted:", nrow(plot_data_spliceai), "\n")
cat("  Chromosomes:", length(chr_levels_spliceai), "\n")
cat("  SpliceAI_score range:", round(min(plot_data_spliceai$SpliceAI_score, na.rm = TRUE), 6), "-",
round(max(plot_data_spliceai$SpliceAI_score, na.rm = TRUE), 6), "\n")
cat("  SpliceAI_score mean:", round(mean(plot_data_spliceai$SpliceAI_score, na.rm = TRUE), 6), "\n")
cat("  SpliceAI_score median:", round(median(plot_data_spliceai$SpliceAI_score, na.rm = TRUE), 6), "\n")
