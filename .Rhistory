plot_df_all <- merged[!is.na(psi_count_ge10) & !is.na(GENE)]
# Label threshold scaled to the full panel, matching how brain_label_min is
# derived for the Brain subset (top ~50 of the panel by tissue count).
all_label_min <- max(1L, as.integer(ceiling(0.5 * max(plot_df_all$psi_count_ge10, na.rm = TRUE))))
cat("All-tissue plot: ", nrow(plot_df_all), " decoys across ",
length(psi_num), " Vast-DB sample columns\n", sep = "")
cat("  label threshold (psi_count_ge10 >= ): ", all_label_min, "\n", sep = "")
p_all_ph100 <- plot_phastcons_y(
plot_df_all,
"psi_count_ge10",
"Number of tissues with PSI > 10",
"phastCons100_mean",
"phastCons 100-way (intron mean)",
"phastCons 100-way vs all Vast-DB tissues with PSI > 10",
label_y_min = all_label_min
)
p_all_ph470 <- plot_phastcons_y(
plot_df_all,
"psi_count_ge10",
"Number of tissues with PSI > 10",
"phastCons470_mean",
"phastCons 470-way (intron mean)",
"phastCons 470-way vs all Vast-DB tissues with PSI > 10",
label_y_min = all_label_min
)
print(p_all_ph100)
print(p_all_ph470)
dir.create("../figures", showWarnings = FALSE, recursive = TRUE)
ggsave(file.path("../figures/phastCons100_vs_all_tissue_psi.pdf"), p_all_ph100, width = 8, height = 6)
ggsave(file.path("../figures/phastCons470_vs_all_tissue_psi.pdf"), p_all_ph470, width = 8, height = 6)
